{
  "name": "sqlite-atlas",
  "displayName": "SQLite Atlas",
  "description": "Browse and edit SQLite databases in VS Code: paginated tables, sorting, filtering, cell editing with undo/redo, row export, and large-file support.",
  "version": "0.1.0",
  "publisher": "bryce-harmon",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "sqlite3",
    "database",
    "db",
    "viewer",
    "editor"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharm16/sqlite-atlas.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sqliteAtlas.view",
        "displayName": "SQLite Atlas",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.db3"
          },
          {
            "filenamePattern": "*.s3db"
          },
          {
            "filenamePattern": "*.sdb"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test 'out/test/*.test.js'",
    "sample": "node scripts/make-sample-db.js"
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
